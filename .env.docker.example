# Copy to .env.docker, then use docker compose --env-file .env.docker ...
GATEWAY_IMAGE=your-dockerhub-username/api-gateway:0.1.0
BIND_ADDRESS=127.0.0.1
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
UPSTREAM_TIMEOUT_MS=10000
# These are proposed platform service DNS names/ports. Both stacks must share a network.
AUTH_SERVICE_URL=http://auth:3001
BOOKING_SERVICE_URL=http://booking:3002
OPERATIONS_SERVICE_URL=http://operations:3003
TRACKING_SERVICE_URL=http://tracking:3004
NOTIFICATION_SERVICE_URL=http://notification:3005
# Placeholder only: replace it in the ignored .env.docker before starting the app.
JWT_SECRET=replace-with-generated-random-secret-at-least-32-bytes
JWT_ISSUER=tablebooking-auth
JWT_AUDIENCE=tablebooking-api
PLATFORM_NETWORK=tablebooking-platform
