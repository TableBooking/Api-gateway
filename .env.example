NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Comma-separated browser origins. Empty means no cross-origin browser access.
CORS_ORIGINS=http://localhost:5173
# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-*.
TRUST_PROXY=false
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
UPSTREAM_TIMEOUT_MS=10000
# Five domain services; /api/users is owned by Auth, not a separate Users service.
# Ports are local integration defaults; align with the platform repository.
AUTH_SERVICE_URL=http://localhost:3001
BOOKING_SERVICE_URL=http://localhost:3002
OPERATIONS_SERVICE_URL=http://localhost:3003
TRACKING_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
# Replace the placeholder with a generated random secret shared by trusted backends.
# Never send this value to the frontend or commit a real secret.
JWT_SECRET=replace-with-generated-random-secret-at-least-32-bytes
# Proposed JWT contract: align these values and the role claim with Auth Service.
JWT_ISSUER=tablebooking-auth
JWT_AUDIENCE=tablebooking-api
