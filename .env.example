NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Comma-separated browser origins. Empty means no cross-origin browser access.
CORS_ORIGINS=http://localhost:5173
# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-*.
TRUST_PROXY=false
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
UPSTREAM_TIMEOUT_MS=10000
MAX_REQUEST_BODY_BYTES=1048576
# Five domain services; /api/users is owned by Auth, not a separate Users service.
# Ports are local integration defaults; align with the platform repository.
AUTH_SERVICE_URL=http://localhost:3001
BOOKING_SERVICE_URL=http://localhost:3002
OPERATIONS_SERVICE_URL=http://localhost:3003
TRACKING_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
# Run npm run keys:generate once, or copy the existing public key from Auth.
# Only Auth holds auth-private.pem; the gateway only reads auth-public.pem.
JWT_PUBLIC_KEY_PATH=./keys/auth-public.pem
# V2 handoff identifiers, not secrets. Must match Auth token claims.
JWT_ISSUER=restaurant-auth
JWT_AUDIENCE=restaurant-api
